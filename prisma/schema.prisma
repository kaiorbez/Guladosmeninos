// Modelo de dados do sistema Gula dos Meninos.
// Cardápio = Category > Product > Variant (tamanho/opção com preço, custo e estoque).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  movements    StockMovement[]
  sales        Sale[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  // Agrupa as categorias no menu lateral: Tortas, Bolos de Pote, Salgados, Doces...
  group       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  // Tortas personalizadas: preço sob consulta, o agente encaminha para um sócio.
  priceOnRequest Boolean   @default(false)
  // Produtos feitos por encomenda não controlam estoque.
  trackStock     Boolean   @default(true)
  // Vende na loja / WhatsApp com o preço da loja. Itens que só existem no PedidosYa ficam false.
  onStore        Boolean   @default(true)
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  // Foto do cardápio (arquivo em /public) ou enviada pelo painel (guardada no banco).
  imageUrl       String?
  photo          Bytes?
  photoType      String?
  photoUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  variants       Variant[]

  @@index([categoryId])
}

model Variant {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ex.: "P", "M", "G", "GG" ou "Único"
  name      String
  // Ex.: "Entre 8 y 10 personas"
  servings  String?
  price     Decimal         @db.Decimal(10, 2)
  cost      Decimal         @default(0) @db.Decimal(10, 2)
  stock     Int             @default(0)
  minStock  Int             @default(0)
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  movements StockMovement[]
  saleItems SaleItem[]
  pedidosYa PedidosYaItem[]

  @@unique([productId, name])
}

enum MovementType {
  ENTRADA // produção / reposição
  SAIDA   // perda, degustação, vencido
  AJUSTE  // contagem manual (define o valor absoluto)
  VENDA   // baixa automática de uma venda
  ESTORNO // venda cancelada
}

model StockMovement {
  id        String       @id @default(cuid())
  variantId String
  variant   Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      MovementType
  // Variação aplicada ao estoque (positiva ou negativa)
  quantity  Int
  stockAfter Int
  note      String?
  saleId    String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([variantId, createdAt])
}

enum SaleChannel {
  BALCAO
  WHATSAPP
  DELIVERY
  INSTAGRAM
  PEDIDOSYA
}

enum SaleStatus {
  CONFIRMADA
  CANCELADA
}

enum PaymentMethod {
  QR
  EFECTIVO
  TARJETA
  OTRO
}

model Sale {
  id            String        @id @default(cuid())
  number        Int           @default(autoincrement()) @unique
  channel       SaleChannel   @default(BALCAO)
  status        SaleStatus    @default(CONFIRMADA)
  payment       PaymentMethod @default(QR)
  customerName  String?
  customerPhone String?
  notes         String?
  total         Decimal       @db.Decimal(10, 2)
  totalCost     Decimal       @default(0) @db.Decimal(10, 2)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  // Referência externa (ex.: id do aviso do agente no WhatsApp): evita registrar a mesma venda 2x.
  externalRef   String?
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  @@index([createdAt])
  @@index([externalRef])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant @relation(fields: [variantId], references: [id])
  // Nome congelado no momento da venda (o produto pode mudar depois)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(10, 2)
}

// Anúncio no PedidosYa: preço próprio (mais caro por causa da taxa do app),
// ligado a um item do cardápio para dar baixa no estoque e comparar preços.
model PedidosYaItem {
  id          String   @id @default(cuid())
  section     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  // Preço "de" quando há desconto no app
  listPrice   Decimal? @db.Decimal(10, 2)
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  // Preço lido de print com baixa resolução: confirmar
  needsReview Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([variantId])
}

// Ajustes de dados que devem rodar uma única vez em cada banco (ver prisma/seed.ts).
model DataMigration {
  id    String   @id
  ranAt DateTime @default(now())
}
