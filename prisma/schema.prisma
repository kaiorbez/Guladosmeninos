// Modelo de dados do sistema Gula dos Meninos.
// Cardápio = Category > Product > Variant (tamanho/opção com preço, custo e estoque).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  movements    StockMovement[]
  sales        Sale[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  // Agrupa as categorias no menu lateral: Tortas, Bolos de Pote, Salgados, Doces...
  group       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  // Tortas personalizadas: preço sob consulta, o agente encaminha para um sócio.
  priceOnRequest Boolean   @default(false)
  // Produtos feitos por encomenda não controlam estoque.
  trackStock     Boolean   @default(true)
  // Vende na loja / WhatsApp com o preço da loja. Itens que só existem no PedidosYa ficam false.
  onStore        Boolean   @default(true)
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  // Foto do cardápio (arquivo em /public) ou enviada pelo painel (guardada no banco).
  imageUrl       String?
  photo          Bytes?
  photoType      String?
  photoUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  variants       Variant[]

  @@index([categoryId])
}

model Variant {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ex.: "P", "M", "G", "GG" ou "Único"
  name      String
  // Ex.: "Entre 8 y 10 personas"
  servings  String?
  price     Decimal         @db.Decimal(10, 2)
  cost      Decimal         @default(0) @db.Decimal(10, 2)
  stock     Int             @default(0)
  minStock  Int             @default(0)
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  movements StockMovement[]
  saleItems SaleItem[]
  pedidosYa PedidosYaItem[]

  @@unique([productId, name])
}

enum MovementType {
  ENTRADA // produção / reposição
  SAIDA   // perda, degustação, vencido
  AJUSTE  // contagem manual (define o valor absoluto)
  VENDA   // baixa automática de uma venda
  ESTORNO // venda cancelada
}

model StockMovement {
  id        String       @id @default(cuid())
  variantId String
  variant   Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      MovementType
  // Variação aplicada ao estoque (positiva ou negativa)
  quantity  Int
  stockAfter Int
  note      String?
  saleId    String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([variantId, createdAt])
}

enum SaleChannel {
  BALCAO
  WHATSAPP
  DELIVERY
  INSTAGRAM
  PEDIDOSYA
}

enum SaleStatus {
  CONFIRMADA
  CANCELADA
}

enum PaymentMethod {
  QR
  EFECTIVO
  TARJETA
  OTRO
}

model Sale {
  id            String        @id @default(cuid())
  number        Int           @default(autoincrement()) @unique
  channel       SaleChannel   @default(BALCAO)
  status        SaleStatus    @default(CONFIRMADA)
  payment       PaymentMethod @default(QR)
  customerName  String?
  customerPhone String?
  notes         String?
  total         Decimal       @db.Decimal(10, 2)
  totalCost     Decimal       @default(0) @db.Decimal(10, 2)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  // Referência externa (ex.: id do aviso do agente no WhatsApp): evita registrar a mesma venda 2x.
  externalRef   String?
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  @@index([createdAt])
  @@index([externalRef])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant @relation(fields: [variantId], references: [id])
  // Nome congelado no momento da venda (o produto pode mudar depois)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(10, 2)
}

// Anúncio no PedidosYa: preço próprio (mais caro por causa da taxa do app),
// ligado a um item do cardápio para dar baixa no estoque e comparar preços.
model PedidosYaItem {
  id          String   @id @default(cuid())
  section     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  // Preço "de" quando há desconto no app
  listPrice   Decimal? @db.Decimal(10, 2)
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  // Preço lido de print com baixa resolução: confirmar
  needsReview Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([variantId])
}

enum OrderStatus {
  PENDENTE
  ENTREGUE
  CANCELADA
}

// Encomenda: a ficha de papel da cozinha (o que produzir, para quando e quanto falta receber).
model Order {
  agentRef      String? @unique
  agentVersion  Int @default(1)
  deliveryMode  String?
  deliveryAddress String?
  deliveryLink String?
  deliveryLinkSentAt DateTime?
  dispatchedAt DateTime?
  agentItems    Json?
  payFull       Boolean @default(false)
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  status        OrderStatus @default(PENDENTE)
  producedAt    DateTime? // pronto na cozinha; continua pendente de entrega
  // Dia da entrega (sem hora) e horário combinado, ex.: "14:00"
  deliveryDate  DateTime    @db.Date
  deliveryTime  String?
  customerName  String
  customerPhone String?
  product       String
  dough         String? // massa
  filling       String? // recheio
  topping       String? // cobertura
  decoration    String?
  total         Decimal     @db.Decimal(10, 2)
  // Soma dos pagamentos (OrderPayment), guardada para listar rápido
  paid          Decimal     @default(0) @db.Decimal(10, 2)
  notes         String?
  // Foto de referência da decoração (enviada pelo painel, guardada no banco)
  decorationPhoto     Bytes?
  decorationPhotoType String?
  decorationPhotoAt   DateTime?
  // Canal da venda gerada na entrega
  channel       SaleChannel @default(WHATSAPP)
  // Venda registrada quando a encomenda foi entregue (entra no faturamento)
  // (sem @unique: o db push do deploy não pode pedir --accept-data-loss)
  saleId        String?
  userId        String?
  createdAt     DateTime    @default(now())
  payments      OrderPayment[]
  activities    OrderActivity[]

  @@index([deliveryDate])
}

model OrderActivity {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Cada valor recebido de uma encomenda (sinal, restante...).
model OrderPayment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Decimal       @db.Decimal(10, 2)
  method  PaymentMethod @default(QR)
  paidAt  DateTime      @default(now())
  // Venda que leva este pagamento ao faturamento no dia em que foi recebido.
  // Pagamentos antigos (sem venda) continuam entrando só na entrega.
  saleId  String?

  @@index([orderId])
}

// Ajustes de dados que devem rodar uma única vez em cada banco (ver prisma/seed.ts).
model DataMigration {
  id    String   @id
  ranAt DateTime @default(now())
}

// Cliente escondido da lista de Clientes (as vendas e encomendas dele continuam intactas).
model HiddenClient {
  key      String   @id // "tel:<celular>" ou "nome:<nome>"
  name     String?
  hiddenAt DateTime @default(now())
}

enum ExpenseCategory {
  ALUGUEL
  FORNECEDOR
  FUNCIONARIO
  ENERGIA
  OUTROS
}

// Despesa para o DRE (aluguel, fornecedor, funcionário, energia, outros).
model Expense {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime        @default(now())

  @@index([date])
}


// Eventos autenticados do WhatsApp: deduplicação e auditoria de ações do agente.
model AgentEvent {
  key       String   @id
  phone     String
  kind      String
  payload   Json
  result    Json?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}

model AgentConversation {
  phone         String   @id
  generation    Int      @default(0)
  latestMoment  BigInt   @default(0)
  pausedUntil   DateTime?
  updatedAt     DateTime @updatedAt
}

model AgentTicket {
  orderId         String?
  id              String   @id @default(cuid())
  sourceKey       String   @unique
  phone           String
  customerName    String
  question        String
  kind            String   @default("DUVIDA")
  status          String   @default("ABERTA")
  answer          String?
  resolvedBy      String?
  resolvedAt      DateTime?
  reminderCount   Int      @default(0)
  nextReminderAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, nextReminderAt])
  @@index([phone, createdAt])
}

model AgentDelivery {
  key          String   @id
  phone        String
  // SENDING/UNKNOWN são deliberadamente não reenviados automaticamente.
  status       String
  messageId    String?  @unique
  ticketId     String?
  body         Json
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([phone, createdAt])
}

model AgentInbox {
  id         String   @id
  phone      String
  messageId  String
  mediaKind  String
  content    String?
  ready      Boolean  @default(false)
  consumedAt DateTime?
  moment     BigInt
  createdAt  DateTime @default(now())
  @@index([phone, consumedAt, moment])
}
