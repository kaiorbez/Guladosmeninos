# Banco PostgreSQL (Railway gera automaticamente ao adicionar um Postgres)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gula"

# Segredo para assinar a sessão do painel (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Primeiro acesso ao painel (usado pelo npm run db:seed)
ADMIN_NAME="Gula dos Meninos"
ADMIN_EMAIL="admin@guladosmeninos.com"
ADMIN_PASSWORD="troque-esta-senha"
